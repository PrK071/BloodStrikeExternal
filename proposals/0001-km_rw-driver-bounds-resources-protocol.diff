+/*
+ * Validates a request before any pointer reaches the memory manager.
+ * The bounds come from the structures, not from a guessed constant:
+ *
+ *   size <= KM_DATA_CAPACITY : the data area is the only buffer a command
+ *       may use, so a larger size would write/read past the mapped view.
+ *   address in user space   : the target is always a user-mode address of
+ *       the target process; kernel addresses are rejected up front.
+ *   address + size - 1      : written as "size - 1 > MAX - address" so the
+ *       comparison cannot overflow a 64-bit sum.
+ */
+static NTSTATUS
+KmValidateRange(ULONG64 pid, ULONG64 address, ULONG64 size)
+{
+    if (pid == 0 || pid > 0xFFFFFFFFULL)          /* PIDs are 32-bit */
+        return STATUS_INVALID_PARAMETER;
+
+    if (size == 0 || size > KM_DATA_CAPACITY)
+        return STATUS_INVALID_BUFFER_SIZE;
+
+    if (address > KM_MAX_USER_ADDRESS)            /* kernel address */
+        return STATUS_INVALID_PARAMETER;
+
+    if (size - 1 > KM_MAX_USER_ADDRESS - address) /* cannot overflow */
+        return STATUS_INVALID_PARAMETER;
+
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS
+KmValidatePid(ULONG64 pid)
+{
+    if (pid == 0 || pid > 0xFFFFFFFFULL)
+        return STATUS_INVALID_PARAMETER;
+
+    return STATUS_SUCCESS;
+}
