diff --git a/km_rw/km_rw_ioctl.c b/km_rw/km_rw_ioctl.c
new file mode 100644
index 0000000..53c8de1
--- /dev/null
+++ b/km_rw/km_rw_ioctl.c
@@ -0,0 +1,400 @@
+/*
+ * km_rw_ioctl.c — kernel read/write driver with a conventional device interface.
+ *
+ * Differences from km_rw.c (shared-section transport):
+ *
+ *   - loaded by the Service Control Manager (sc create / sc start), so it is a
+ *     normal WDM driver: DriverEntry receives a real DriverObject, the driver
+ *     owns a device object and a symbolic link, and it has a DriverUnload;
+ *   - no shared section, no polling thread, no global pointer to any buffer
+ *     that outlives a single request. The I/O manager owns the buffer, copies
+ *     the request in and the answer out, and guarantees its lifetime for the
+ *     duration of the IRP;
+ *   - the request is self-describing and fully validated before any pointer
+ *     reaches the memory manager.
+ *
+ * ABI (shared with the client):
+ *
+ *   KM_REQUEST { ULONG64 Pid; ULONG64 Address; ULONG64 Size; }   // 0x18 bytes
+ *
+ *   IOCTL_KM_READ        in: KM_REQUEST
+ *                        out: Size bytes of the target address space
+ *   IOCTL_KM_WRITE       in: KM_REQUEST followed by Size bytes of payload
+ *                        out: none
+ *   IOCTL_KM_IMAGE_PATH  in: KM_REQUEST (only Pid is used)
+ *                        out: NUL-terminated WCHAR image path
+ *
+ * The device has no explicit security descriptor, so it keeps the default one
+ * (SYSTEM and Administrators). The client must therefore run elevated. If that
+ * is not acceptable, replace IoCreateDevice with IoCreateDeviceSecure and an
+ * explicit SDDL instead of relaxing the default.
+ */
+
+#include <ntifs.h>
+
+/* Missing from this WDK header set; exported by ntoskrnl. */
+NTSTATUS MmCopyVirtualMemory(
+    PEPROCESS SourceProcess, PVOID SourceAddress,
+    PEPROCESS TargetProcess, PVOID TargetAddress,
+    SIZE_T BufferSize, KPROCESSOR_MODE PreviousMode, PSIZE_T ReturnSize);
+PPEB PsGetProcessPeb(PEPROCESS Process);
+
+#define KM_DEVICE_NAME  L"\\Device\\KmRw"
+#define KM_SYMLINK_NAME L"\\DosDevices\\KmRw"
+#define KM_POOL_TAG     'KmRw'
+
+/*
+ * Largest transfer accepted in a single IRP.
+ *
+ * METHOD_BUFFERED makes the I/O manager allocate a non-paged system buffer of
+ * max(InputBufferLength, OutputBufferLength) for every request. 1 MB keeps that
+ * allocation bounded and predictable; the client splits larger transfers. This
+ * is our own limit, not a Windows constant.
+ */
+#define KM_MAX_XFER 0x100000
+
+/* Image path comes from a UNICODE_STRING: Length is USHORT (bytes). */
+#define KM_MAX_PATH_CHARS 0x8000
+
+/* Top of user space on x64 (47-bit); anything above is kernel space. */
+#define KM_MAX_USER_ADDRESS 0x00007FFFFFFF0000ULL
+
+typedef struct _KM_REQUEST {
+    ULONG64 Pid;
+    ULONG64 Address;
+    ULONG64 Size;
+} KM_REQUEST, *PKM_REQUEST;
+
+C_ASSERT(sizeof(KM_REQUEST) == 0x18);
+
+#define IOCTL_KM_READ       CTL_CODE(FILE_DEVICE_UNKNOWN, 0x800, METHOD_BUFFERED, \
+                                     FILE_READ_DATA | FILE_WRITE_DATA)
+#define IOCTL_KM_WRITE      CTL_CODE(FILE_DEVICE_UNKNOWN, 0x801, METHOD_BUFFERED, \
+                                     FILE_READ_DATA | FILE_WRITE_DATA)
+#define IOCTL_KM_IMAGE_PATH CTL_CODE(FILE_DEVICE_UNKNOWN, 0x802, METHOD_BUFFERED, \
+                                     FILE_READ_DATA)
+
+/* ------------------------------------------------------------------ */
+
+/*
+ * Same validation as km_rw.c, but with the transfer cap of this interface.
+ *
+ *   size    <= KM_MAX_XFER      : bounded by the buffered I/O allocation
+ *   address + size - 1          : inside user space, compared as
+ *                                 "size - 1 > MAX - address" so no overflow
+ */
+static NTSTATUS
+KmValidateRange(ULONG64 pid, ULONG64 address, ULONG64 size)
+{
+    if (pid == 0 || pid > 0xFFFFFFFFULL)          /* PIDs are 32-bit */
+        return STATUS_INVALID_PARAMETER;
+
+    if (size == 0 || size > KM_MAX_XFER)
+        return STATUS_INVALID_BUFFER_SIZE;
+
+    if (address > KM_MAX_USER_ADDRESS)            /* kernel address */
+        return STATUS_INVALID_PARAMETER;
+
+    if (size - 1 > KM_MAX_USER_ADDRESS - address) /* cannot overflow */
+        return STATUS_INVALID_PARAMETER;
+
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS
+KmValidatePid(ULONG64 pid)
+{
+    if (pid == 0 || pid > 0xFFFFFFFFULL)
+        return STATUS_INVALID_PARAMETER;
+
+    return STATUS_SUCCESS;
+}
+
+/*
+ * PreviousMode is KernelMode: the caller-side buffer is the system buffer, a
+ * kernel address. With UserMode the routine would ProbeForWrite() that address
+ * and reject it. The target side is user memory and is validated internally by
+ * MmCopyVirtualMemory (attach + SEH, reported as NTSTATUS).
+ */
+static NTSTATUS
+KmReadProcess(ULONG64 pid, ULONG64 address, PVOID out, ULONG64 size, PULONG outUsed)
+{
+    PEPROCESS target = NULL;
+    SIZE_T copied = 0;
+    NTSTATUS st;
+
+    st = PsLookupProcessByProcessId((HANDLE)(ULONG_PTR)pid, &target);
+    if (!NT_SUCCESS(st))
+        return st;
+
+    st = MmCopyVirtualMemory(target, (PVOID)(ULONG_PTR)address,
+                             PsGetCurrentProcess(), out,
+                             (SIZE_T)size, KernelMode, &copied);
+    ObDereferenceObject(target);
+
+    if (NT_SUCCESS(st))
+        *outUsed = (ULONG)copied;
+
+    return st;
+}
+
+static NTSTATUS
+KmWriteProcess(ULONG64 pid, ULONG64 address, PVOID payload, ULONG64 size)
+{
+    PEPROCESS target = NULL;
+    SIZE_T copied = 0;
+    NTSTATUS st;
+
+    st = PsLookupProcessByProcessId((HANDLE)(ULONG_PTR)pid, &target);
+    if (!NT_SUCCESS(st))
+        return st;
+
+    st = MmCopyVirtualMemory(PsGetCurrentProcess(), payload,
+                             target, (PVOID)(ULONG_PTR)address,
+                             (SIZE_T)size, KernelMode, &copied);
+    ObDereferenceObject(target);
+
+    return st;
+}
+
+static NTSTATUS
+KmImagePathProcess(ULONG64 pid, PWCHAR out, ULONG outChars, PULONG charsWritten)
+{
+    PEPROCESS target = NULL;
+    PPEB      peb;
+    ULONG64   params = 0;
+    SIZE_T    bytes  = 0;
+    NTSTATUS  st;
+
+    if (outChars == 0)
+        return STATUS_BUFFER_TOO_SMALL;
+
+    st = PsLookupProcessByProcessId((HANDLE)(ULONG_PTR)pid, &target);
+    if (!NT_SUCCESS(st))
+        return st;
+
+    peb = PsGetProcessPeb(target);
+    if (!peb) {
+        ObDereferenceObject(target);
+        return STATUS_NOT_FOUND;
+    }
+
+    st = MmCopyVirtualMemory(target, (PVOID)((ULONG_PTR)peb + 0x20),
+                             PsGetCurrentProcess(), &params,
+                             sizeof(params), KernelMode, &bytes);
+    if (!NT_SUCCESS(st) || !params) {
+        ObDereferenceObject(target);
+        return STATUS_NOT_FOUND;
+    }
+
+    UNICODE_STRING name = { 0 };
+    st = MmCopyVirtualMemory(target, (PVOID)(params + 0x60),
+                             PsGetCurrentProcess(), &name,
+                             sizeof(name), KernelMode, &bytes);
+    if (!NT_SUCCESS(st) || !name.Buffer || !name.Length) {
+        ObDereferenceObject(target);
+        return STATUS_NOT_FOUND;
+    }
+
+    ULONG chars = name.Length / sizeof(WCHAR);
+    if (chars >= KM_MAX_PATH_CHARS)          /* Length is USHORT */
+        chars = KM_MAX_PATH_CHARS - 1;
+    if (chars >= outChars)
+        chars = outChars - 1;
+
+    /* The destination is the kernel system buffer, already large enough. */
+    st = MmCopyVirtualMemory(target, name.Buffer, PsGetCurrentProcess(), out,
+                             chars * sizeof(WCHAR), KernelMode, &bytes);
+    if (NT_SUCCESS(st)) {
+        out[chars] = L'\0';
+        *charsWritten = chars + 1;
+    }
+
+    ObDereferenceObject(target);
+    return st;
+}
+
+/* ------------------------------------------------------------------ */
+
+static NTSTATUS
+KmCreateClose(PDEVICE_OBJECT DeviceObject, PIRP Irp)
+{
+    UNREFERENCED_PARAMETER(DeviceObject);
+
+    Irp->IoStatus.Status = STATUS_SUCCESS;
+    Irp->IoStatus.Information = 0;
+    IoCompleteRequest(Irp, IO_NO_INCREMENT);
+
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS
+KmDeviceControl(PDEVICE_OBJECT DeviceObject, PIRP Irp)
+{
+    PIO_STACK_LOCATION sp = IoGetCurrentIrpStackLocation(Irp);
+    PVOID  buffer = Irp->AssociatedIrp.SystemBuffer;
+    ULONG  inLen  = sp->Parameters.DeviceIoControl.InputBufferLength;
+    ULONG  outLen = sp->Parameters.DeviceIoControl.OutputBufferLength;
+    ULONG  used   = 0;
+    NTSTATUS st   = STATUS_INVALID_DEVICE_REQUEST;
+
+    UNREFERENCED_PARAMETER(DeviceObject);
+
+    /*
+     * The request header is copied into locals before anything is written to
+     * the buffer: with METHOD_BUFFERED the output overwrites the same memory
+     * that holds the input header.
+     */
+    switch (sp->Parameters.DeviceIoControl.IoControlCode) {
+
+    case IOCTL_KM_READ:
+    {
+        ULONG64 pid, address, size;
+
+        if (inLen < sizeof(KM_REQUEST)) {
+            st = STATUS_BUFFER_TOO_SMALL;
+            break;
+        }
+        pid     = ((PKM_REQUEST)buffer)->Pid;
+        address = ((PKM_REQUEST)buffer)->Address;
+        size    = ((PKM_REQUEST)buffer)->Size;
+
+        st = KmValidateRange(pid, address, size);
+        if (!NT_SUCCESS(st))
+            break;
+        if (size > outLen) {                 /* answer must fit the output */
+            st = STATUS_BUFFER_TOO_SMALL;
+            break;
+        }
+
+        st = KmReadProcess(pid, address, buffer, size, &used);
+        break;
+    }
+
+    case IOCTL_KM_WRITE:
+    {
+        ULONG64 pid, address, size;
+
+        if (inLen < sizeof(KM_REQUEST)) {
+            st = STATUS_BUFFER_TOO_SMALL;
+            break;
+        }
+        pid     = ((PKM_REQUEST)buffer)->Pid;
+        address = ((PKM_REQUEST)buffer)->Address;
+        size    = ((PKM_REQUEST)buffer)->Size;
+
+        st = KmValidateRange(pid, address, size);
+        if (!NT_SUCCESS(st))
+            break;
+        /* inLen >= sizeof(KM_REQUEST) here, so the subtraction cannot wrap. */
+        if (size > (ULONG64)(inLen - sizeof(KM_REQUEST))) {
+            st = STATUS_BUFFER_TOO_SMALL;
+            break;
+        }
+
+        st = KmWriteProcess(pid, address,
+                            (PUCHAR)buffer + sizeof(KM_REQUEST), size);
+        /* Information stays 0: with METHOD_BUFFERED the I/O manager copies
+         * Information bytes back to the caller's *output* buffer, which for a
+         * write is empty. Reporting Size here would make it copy past it. */
+        break;
+    }
+
+    case IOCTL_KM_IMAGE_PATH:
+    {
+        ULONG64 pid;
+        ULONG   chars = 0;
+
+        if (inLen < sizeof(KM_REQUEST) || outLen < sizeof(WCHAR)) {
+            st = STATUS_BUFFER_TOO_SMALL;
+            break;
+        }
+        pid = ((PKM_REQUEST)buffer)->Pid;
+
+        st = KmValidatePid(pid);
+        if (!NT_SUCCESS(st))
+            break;
+
+        st = KmImagePathProcess(pid, (PWCHAR)buffer,
+                                outLen / sizeof(WCHAR), &chars);
+        if (NT_SUCCESS(st))
+            used = chars * sizeof(WCHAR);
+        break;
+    }
+
+    default:
+        break;
+    }
+
+    Irp->IoStatus.Status = st;
+    Irp->IoStatus.Information = used;
+    IoCompleteRequest(Irp, IO_NO_INCREMENT);
+
+    return st;
+}
+
+/* ------------------------------------------------------------------ */
+
+static VOID
+KmUnload(PDRIVER_OBJECT DriverObject)
+{
+    UNICODE_STRING linkName;
+
+    /*
+     * Order matters: remove the link first, so no new open can find the
+     * device, then delete the device. The I/O manager refuses to unload while
+     * a handle is still open, so there is no request in flight at this point.
+     */
+    RtlInitUnicodeString(&linkName, KM_SYMLINK_NAME);
+    IoDeleteSymbolicLink(&linkName);
+
+    if (DriverObject->DeviceObject != NULL)
+        IoDeleteDevice(DriverObject->DeviceObject);
+}
+
+/* ------------------------------------------------------------------ */
+
+NTSTATUS
+DriverEntry(PDRIVER_OBJECT DriverObject, PUNICODE_STRING RegistryPath)
+{
+    UNICODE_STRING deviceName;
+    UNICODE_STRING linkName;
+    PDEVICE_OBJECT deviceObject = NULL;
+    NTSTATUS st;
+
+    UNREFERENCED_PARAMETER(RegistryPath);
+
+    RtlInitUnicodeString(&deviceName, KM_DEVICE_NAME);
+
+    /*
+     * FILE_DEVICE_SECURE_OPEN applies the device security descriptor to every
+     * open by name, instead of only to the first one. Exclusive = TRUE prevents
+     * a second handle from bypassing the lifecycle guarantees.
+     */
+    st = IoCreateDevice(DriverObject, 0, &deviceName, FILE_DEVICE_UNKNOWN,
+                        FILE_DEVICE_SECURE_OPEN, TRUE, &deviceObject);
+    if (!NT_SUCCESS(st))
+        return st;
+
+    RtlInitUnicodeString(&linkName, KM_SYMLINK_NAME);
+    st = IoCreateSymbolicLink(&linkName, &deviceName);
+    if (!NT_SUCCESS(st)) {
+        IoDeleteDevice(deviceObject);
+        return st;
+    }
+
+    DriverObject->MajorFunction[IRP_MJ_CREATE]         = KmCreateClose;
+    DriverObject->MajorFunction[IRP_MJ_CLEANUP]        = KmCreateClose;
+    DriverObject->MajorFunction[IRP_MJ_CLOSE]          = KmCreateClose;
+    DriverObject->MajorFunction[IRP_MJ_DEVICE_CONTROL] = KmDeviceControl;
+    DriverObject->DriverUnload                         = KmUnload;
+
+    /*
+     * Buffering is requested per IOCTL (METHOD_BUFFERED in CTL_CODE); the
+     * device object does not need DO_BUFFERED_IO, and this driver does not
+     * implement IRP_MJ_READ/IRP_MJ_WRITE.
+     */
+    deviceObject->Flags &= ~DO_DEVICE_INITIALIZING;
+
+    return STATUS_SUCCESS;
+}
