# Local interpreter caches and reports that contain per-machine runtime state.
__pycache__/
*.py[cod]
*.log
.venv/
venv/

# Portable analysis dependencies are installed on demand by repository scripts.
/tools/providers/
/tools/npm-*/
/tools/rea-source/
/tools/rea-runtime/

# Ghidra databases are large, binary, and tied to the local analysis session.
/StaticAnalysis/integration-evidence/rea/ghidra-project/
*.gpr
*.rep/

# Runtime module images remain local; publish their manifests and reports only.
/reports/**/BloodStrike.mapped-image.bin

# Generated native binaries and local session state.
*.exe
*.pdb
/native/*.bmp
/native/*.json
/live-session.json
/menu-session.json
